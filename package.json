{
  "name": "spv-token-system",
  "version": "1.0.0",
  "private": true,
  "description": "SPV token monorepo — contracts, web, chat",
  "license": "MIT",
  "scripts": {
    "install:all": "npm --prefix contracts install && npm --prefix web install && npm --prefix apps/chat install",
    "install:contracts": "npm --prefix contracts install",
    "install:web": "npm --prefix web install",
    "install:chat": "npm --prefix apps/chat install",
    "compile": "npm --prefix contracts run compile",
    "test": "npm --prefix contracts run test",
    "deploy:amoy": "npm --prefix contracts run deploy:amoy",
    "deploy:polygon": "npm --prefix contracts run deploy:polygon",
    "interact:amoy": "npm --prefix contracts run interact:amoy",
    "interact:polygon": "npm --prefix contracts run interact:polygon",
    "export:amoy": "npm --prefix contracts run export:amoy",
    "export:polygon": "npm --prefix contracts run export:polygon",
    "dev": "npm --prefix web run dev",
    "dev:chat": "npm --prefix apps/chat run dev",
    "build": "npm --prefix web run build",
    "build:chat": "npm --prefix apps/chat run build",
    "preview": "npm --prefix web run preview"
  }
}